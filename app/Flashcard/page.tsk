"use client";

import { useCallback, useEffect, useState } from "react";
import { useStudy } from "@/lib/store";
import EmptyState from "@/components/EmptySt

export default function FlashcardsPage() {
  const { ready, studyPackage, mastered, toggleMastered } = useStudy();
  const [i, setI] = useState(0);
  const [flipped, setFlipped] = useState(false);
  const cards = studyPackage?.flashcards ?? [];

  const go = useCallback((d: number) => {
    setFlipped(false);
    setI((p) => Math.min(Math.max(p + d, 0), Math.max(cards.length - 1, 0)));
  }, [cards.length]);

  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "ArrowRight") go(1);
      else if (e.key === "ArrowLeft") go(-1);
      else if (e.key === " ") { e.preventDefault(); setFlipped((f) => !f); }
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [go]);

  if (!ready) return null;
  if (!cards.length) return <EmptyState title="No flashcards yet" />;

  const card = cards[i];
  const isMastered = mastered.includes(i);

  return (
    <div className="max-w-2xl mx-auto space-y-6">
      <div>
        <div className="flex justify-between text-xs text-slate-400 mb-2">
          <span>Card {i + 1} of {cards.length}</span>
          <span>{mastered.length} mastered</span>
        </div>
        <div className="h-1.5 rounded-full bg-slate-800 overflow-hidden">
          <div className="h-full bg-gradient-to-r from-indigo-500 to-cyan-400 transition-all" style={{ width: `${((i + 1) / cards.length) * 100}%` }} />
        </div>
      </div>

      <button
        onClick={() => setFlipped((f) => !f)}
        aria-label="Flip card"
        className={`w-full min-h-[280px] rounded-3xl border p-8 text-left transition-all flex flex-col justify-center ${
          flipped ? "border-emerald-500/30 bg-emerald-950/20" : "border-slate-800 bg-slate-900/60 hover:border-indigo-500/40"
        }`}
      >
        <span className={`text-xs font-semibold ${flipped ? "text-emerald-400" : "text-indigo-400"}`}>
          {flipped ? "Answer" : "Question"}
        </span>
        <p className="mt-3 text-xl font-semibold text-white leading-relaxed">{flipped ? card.back : card.front}</p>
        <span className="mt-6 text-xs text-slate-500">Tap or press space to flip</span>
      </button>

      <div className="flex items-center justify-between gap-3">
        <button onClick={() => go(-1)} disabled={i === 0} className="rounded-xl border border-slate-800 px-4 py-2.5 text-sm text-slate-300 disabled:opacity-40 hover:bg-slate-800/50">← Prev</button>
        <button
          onClick={() => toggleMastered(i)}
          className={`rounded-xl px-4 py-2.5 text-sm font-semibold transition-all ${
            isMastered ? "bg-emerald-600/20 text-emerald-300 border border-emerald-500/30" : "bg-indigo-600 text-white hover:bg-indigo-500"
          }`}
        >
          {isMastered ? "✓ Mastered" : "Mark as mastered"}
        </button>
        <button onClick={() => go(1)} disabled={i === cards.length - 1} className="rounded-xl border border-slate-800 px-4 py-2.5 text-sm text-slate-300 disabled:opacity-40 hover:bg-slate-800/50">Next →</button>
      </div>
    </div>
  );
}